{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"message": {"format": "%(message)s"}},
  "handlers": {"console": {"class": "logging.StreamHandler", "formatter": "message", "stream": "ext://sys.stdout"}},
  "loggers": {"bank_marketing.serving": {"level": "INFO", "handlers": ["console"], "propagate": false}}
}
